# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/crawler.db
# DATABASE_URL=postgresql+psycopg://crawler:crawler@postgres:5432/crawler
REDIS_URL=redis://localhost:6379/0

# --- Filtering ---------------------------------------------------------------
# Comma separated. Added to config/platforms.yaml excluded_platforms.
PLATFORM_EXCLUSIONS=immunefi
# Comma separated classifications to keep (empty = all):
# PRIVATE_CONFIRMED,PRIVATE_POSSIBLE,PUBLIC,VDP_ONLY,UNKNOWN
PROGRAM_TYPE_FILTER=
MIN_BOUNTY=0
PRIVATE_ONLY=true

# --- Authorization gates -----------------------------------------------------
REQUIRE_BOUNTY_CONFIRMATION=true
REQUIRE_EXPLICIT_SCOPE=true
# Days an authorization stays valid when the response gives no expiry date.
AUTHORIZATION_EXPIRY=90
# Research actions are blocked unless this is true. It can only be changed
# here (environment), never from the API or dashboard.
RESEARCH_MODE=false

# --- Email -----------------------------------------------------------------
# Empty (default): the first `crawler authorize send` asks for SMTP settings
# once and saves them (~/.config/web3-crawler/smtp.json, password in the OS
# keyring when available). none: never send. smtp: send using the SMTP_*
# values below or the saved settings. Setup also asks once whether emails
# may be sent without asking each time (only to a program's published
# security contact, one per program, rate limited).
EMAIL_PROVIDER=
# SMTP_* variables override the saved settings when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
# Standing approval when SMTP comes from these env vars (the saved file
# stores its own answer).
AUTO_SEND=false
AUTO_SEND_MAX_PER_HOUR=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional inbox monitoring for responses (IMAP over TLS).
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Researcher identity used in generated emails ----------------------------
RESEARCHER_NAME=Your Name
RESEARCHER_CONTACT=you@example.com

# --- Collectors ----------------------------------------------------------------
# HackerOne Hacker API credentials (lists programs you have been invited to).
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=
CRAWLER_USER_AGENT=web3-crawler/0.1 (+authorization-first research tool)
REQUEST_DELAY_SECONDS=2

# --- Asset intelligence (public indexes only) ----------------------------------
ETHERSCAN_API_KEY=

# --- Optional ChatGPT extraction ---------------------------------------------
# Set OPENAI_API_KEY to let the crawler send public program/policy pages to
# the model and pull out bounty, scope and private-program details. Values
# are checked against the page text; the model never affects authorization.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works.
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_PAGES=50

# --- Notifications ---------------------------------------------------------------
# Optional webhook that receives notification JSON (e.g. your own Slack hook).
NOTIFY_WEBHOOK_URL=
